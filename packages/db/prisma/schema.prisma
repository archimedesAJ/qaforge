generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users & projects
// ─────────────────────────────────────────────────────────────

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String
  passwordHash  String
  activated     Boolean         @default(false)
  systemAdmin   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ownedProjects  Project[]       @relation("OwnedProjects")
  memberships    ProjectMember[]
  casesCreated   TestCase[]      @relation("CaseAuthor")
  sentInvites    UserInvite[]    @relation("InviteSender")
  comments       CaseComment[]   @relation("CommentAuthor")
  caseLinks      CaseLink[]      @relation("LinkAuthor")
  plansCreated   TestPlan[]      @relation("PlanAuthor")
  setsCreated    TestSet[]       @relation("SetAuthor")
  oneOnOnesLed   LeadershipOneOnOne[] @relation("OneOnOneLead")
  oneOnOnesAsReport LeadershipOneOnOne[] @relation("OneOnOneReport")
  leadershipReviews LeadershipReview[] @relation("LeadershipPresenter")
  leadershipEntries LeadershipReviewEntry[] @relation("LeadershipEmployee")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  category  String?
  stage     String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User            @relation("OwnedProjects", fields: [ownerId], references: [id])
  members   ProjectMember[]
  suites    TestSuite[]
  cases     TestCase[]
  runs      TestRun[]
  plans     TestPlan[]
  sets      TestSet[]
  invites   UserInvite[]
  defects   Defect[]
}

model ProjectMember {
  projectId            String
  userId               String
  role                 String   @default("editor") // admin | manager | editor | viewer
  canBulkUploadDefects Boolean  @default(false)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ApiKey {
  id         String    @id @default(uuid())
  projectId  String
  name       String
  keyHash    String    @unique
  scope      String    @default("write:results")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model UserInvite {
  id          String   @id @default(uuid())
  email       String
  token       String   @unique
  projectId   String
  role        String   @default("editor") // manager | editor | viewer
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([token])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Test cases & suites
// ─────────────────────────────────────────────────────────────

model TestSuite {
  id        String      @id @default(uuid())
  projectId String
  name      String
  parentId  String?
  createdAt DateTime    @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    TestSuite?  @relation("SuiteTree", fields: [parentId], references: [id])
  children  TestSuite[] @relation("SuiteTree")
  cases     TestCase[]
}

model TestCase {
  id            String    @id @default(uuid())
  seqId         Int       @unique @default(autoincrement())
  lineageId     String?
  projectId     String
  suiteId       String?
  title         String
  type          String    // manual | functional | ui_auto | api | perf | exploratory
  priority      String    @default("p2")
  version       Int       @default(1)
  steps         Json?
  tags          Json      @default("[]")
  preconditions String?
  archived      Boolean   @default(false)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite      TestSuite?    @relation(fields: [suiteId], references: [id])
  createdBy  User          @relation("CaseAuthor", fields: [createdById], references: [id])
  results    RunResult[]
  runCases   RunCase[]
  setItems   TestSetItem[]
}

model TestSet {
  id          String        @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("SetAuthor", fields: [createdById], references: [id])
  items       TestSetItem[]

  @@index([projectId])
}

model TestSetItem {
  id         Int    @id @default(autoincrement())
  setId      String
  testCaseId String

  set      TestSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id])

  @@unique([setId, testCaseId])
  @@index([setId])
}

model CaseLink {
  id          String   @id @default(uuid())
  lineageId   String
  type        String   // jira | github | requirement | other
  label       String
  url         String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("LinkAuthor", fields: [createdById], references: [id])
}

model CaseComment {
  id          String   @id @default(uuid())
  lineageId   String
  content     String
  parentId    String?
  edited      Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User          @relation("CommentAuthor", fields: [createdById], references: [id])
  parent    CaseComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies   CaseComment[] @relation("CommentThread")
}

// ─────────────────────────────────────────────────────────────
// Runs & results
// ─────────────────────────────────────────────────────────────

model TestPlan {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  milestone   String?
  description String?
  status      String    @default("active") // active | archived
  endsAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("PlanAuthor", fields: [createdById], references: [id])
  runs        TestRun[]

  @@index([projectId])
}

model TestRun {
  id          String    @id @default(uuid())
  projectId   String
  planId      String?
  name        String
  env         String
  source      String    // manual | ci_github | ci_gitlab | api
  status      String    @default("open")
  triggeredBy String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan     TestPlan?            @relation(fields: [planId], references: [id])
  results  RunResult[]
  session  ExploratorySession?
  runCases RunCase[]
}

model RunCase {
  id         Int      @id @default(autoincrement())
  runId      String
  testCaseId String
  status     String   @default("not_run") // not_run | pass | fail | blocked | skipped
  note       String?  // QA reason for blocked / skipped / fail
  updatedAt  DateTime @updatedAt

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id])

  @@unique([runId, testCaseId])
  @@index([runId])
}

model RunResult {
  id               Int       @id @default(autoincrement())
  runId            String
  testCaseId       String
  testCaseVersion  Int
  status           String    // pass | fail | blocked | skipped | not_applicable
  durationMs       Int?
  stepsLog         Json?
  attachments      Json?
  failureNote      String?
  errorMessage     String?
  stackTrace       String?
  executedAt       DateTime  @default(now())

  run      TestRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase  @relation(fields: [testCaseId], references: [id])
  defects  Defect[]

  @@index([runId])
  @@index([testCaseId])
  @@index([runId, status])
}

model Defect {
  id              String  @id @default(uuid())
  clientRequestId String? @unique
  projectId       String
  runResultId Int?
  title       String?
  tracker     String    // jira | github | linear | internal
  externalRef String?   // full URL to the ticket
  status      String    @default("open")   // open | in_progress | resolved | closed | wont_fix
  severity    String    @default("medium") // critical | high | medium | low
  notes       String?
  attachments Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runResult RunResult? @relation(fields: [runResultId], references: [id])

  @@index([projectId])
  @@index([runResultId])
}
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  userEmail   String
  projectId   String?
  projectName String?
  action      String
  entityType  String
  entityId    String?
  entityName  String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model ExploratorySession {
  id                  String    @id @default(uuid())
  runId               String    @unique
  charter             String
  area                String?
  riskFocus           String?
  plannedDurationMins Int?
  testerId            String
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  sessionLog          Json?
  debrief             String?
  verdict             String?   // thorough | partial | incomplete

  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Pre-aggregated insights (written on run close, read on dashboard)
// ─────────────────────────────────────────────────────────────

model CoverageSnapshot {
  id          String    @id @default(uuid())
  projectId   String
  testCaseId  String
  passRate    Float?
  lastRunAt   DateTime?
  state       String    // healthy | stale | failing
  computedAt  DateTime  @default(now())

  @@unique([projectId, testCaseId])
  @@index([projectId])
}

model FlakinessScore {
  id           String   @id @default(uuid())
  projectId    String
  testCaseId   String
  score        Float    // 0.0 – 1.0
  runsAnalysed Int
  lastSeenAt   DateTime
  computedAt   DateTime @default(now())

  @@unique([projectId, testCaseId])
  @@index([projectId, score])
}

model TrendSeries {
  id        String   @id @default(uuid())
  projectId String
  date      DateTime @db.Date
  env       String?
  suiteId   String?
  passRate  Float
  totalRuns Int

  @@unique([projectId, date, env, suiteId])
  @@index([projectId, date])
}

// ─────────────────────────────────────────────────────────────
// System-admin leadership reviews
// ─────────────────────────────────────────────────────────────

model LeadershipOneOnOne {
  id                  String   @id @default(uuid())
  leadId              String
  reportId            String
  meetingDate         DateTime @db.Date
  wins                Json     @default("[]")
  discussionPoints    Json     @default("[]")
  challenges          Json     @default("[]")
  learningDevelopment Json     @default("[]")
  managerFeedback     Json     @default("[]")
  actions             Json     @default("[]")
  privateNotes        String?
  presentationSummary String?
  nextMeetingDate     DateTime? @db.Date
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lead   User @relation("OneOnOneLead", fields: [leadId], references: [id])
  report User @relation("OneOnOneReport", fields: [reportId], references: [id])

  @@index([leadId, meetingDate])
  @@index([reportId, meetingDate])
}

model LeadershipReview {
  id                  String   @id @default(uuid())
  presenterId         String
  department          String
  unitName            String
  reportingPeriod     DateTime @db.Date
  meetingDate         DateTime? @db.Date
  status              String   @default("draft") // draft | ready | presented | closed
  unitHighlights      Json     @default("[]")
  nextPeriodFocus     Json     @default("[]")
  workingFeedback     Json     @default("[]")
  challengesSupport   Json     @default("[]")
  decisionsActions    Json     @default("[]")
  crossTeamDependencies Json   @default("[]")
  followUps           Json     @default("[]")
  nextMeetingDate     DateTime? @db.Date
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  presenter User @relation("LeadershipPresenter", fields: [presenterId], references: [id])
  entries   LeadershipReviewEntry[]

  @@index([presenterId, reportingPeriod])
}

model LeadershipReviewEntry {
  id                  String @id @default(uuid())
  reviewId            String
  employeeId          String
  jobTitle            String?
  teamUnit            String?
  tasksAchieved       Json   @default("[]")
  inProgress          Json   @default("[]")
  planned             Json   @default("[]")
  oneOnOneSummary     Json   @default("[]")
  learningDevelopment Json   @default("[]")
  managerFeedback     Json   @default("[]")
  ldHours             Float  @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  review   LeadershipReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  employee User @relation("LeadershipEmployee", fields: [employeeId], references: [id])

  @@unique([reviewId, employeeId])
  @@index([employeeId])
}
