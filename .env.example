# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=qaforge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=qaforge

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Set to true ONLY to register the first admin account, then remove or set to false
REGISTRATION_ENABLED=false

# ── MinIO (object storage) ───────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# ── Web ──────────────────────────────────────────────────────
# The public URL where QAForge is hosted (used for CORS)
WEB_BASE_URL=http://localhost
PORT=80
MINIO_CONSOLE_PORT=9001

# ── Email (optional) ─────────────────────────────────────────
# Sign up free at https://resend.com — needed to send invite emails
# Without this, invite links are printed to the API console log instead
RESEND_API_KEY=
EMAIL_FROM=QAForge <noreply@yourdomain.com>

# ── AI (optional) ────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=
