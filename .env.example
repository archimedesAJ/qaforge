# ── Database ─────────────────────────────────────────────────
# Full connection string — used directly by the API
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Set to true ONLY to register the first admin account, then remove or set to false
REGISTRATION_ENABLED=false

# ── MinIO (object storage) ───────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# ── Web ──────────────────────────────────────────────────────
# The public URL where QAForge is hosted (used for CORS)
WEB_BASE_URL=http://localhost
PORT=8000
MINIO_CONSOLE_PORT=9001

# ── Email — Microsoft Graph API (Azure App Registration) ─────
# Required to send invite emails. Without these, invite links are
# printed to the API console log instead.
#
# Setup:
#   1. Azure Portal → App registrations → New registration
#   2. API permissions → Add → Microsoft Graph → Application → Mail.Send → Grant admin consent
#   3. Certificates & secrets → New client secret → copy value below
#   4. EMAIL_FROM must be a licensed M365 mailbox or shared mailbox in your tenant
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
EMAIL_FROM=QAForge <noreply@yourdomain.com>

# ── AI (optional) ────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI powers leadership-review drafting. Keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
