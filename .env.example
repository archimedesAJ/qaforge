# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=qaforge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=qaforge

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── MinIO (object storage) ───────────────────────────────────
